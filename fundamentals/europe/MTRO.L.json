 Investments Limited.","fullTimeEmployees":2891,"companyOfficers":[{"maxAge":1,"name":"Mr. Daniel Sweeney Frumkin","age":61,"title":"CEO & Director","yearBorn":1964,"fiscalYear":2025,"totalPay":2195367,"exercisedValue":0,"unexercisedValue":444777},{"maxAge":1,"name":"Mr. Marc Stephen Page","age":52,"title":"CFO & Director","yearBorn":1973,"fiscalYear":2025,"totalPay":1199131,"exercisedValue":0,"unexercisedValue":181111},{"maxAge":1,"name":"Ms. Cristina Alba Ochoa","age":52,"title":"Executive Director","yearBorn":1973,"fiscalYear":2025,"exercisedValue":0,"unexercisedValue":0},{"maxAge":1,"name":"Mr. Faisal  Hussain","title":"Chief Operating Officer","fiscalYear":2025,"exercisedValue":0,"unexercisedValue":0},{"maxAge":1,"name":"Ms. Danielle  Lee","title":"Director of Brand & Marketing","fiscalYear":2025,"exercisedValue":0,"unexercisedValue":0},{"maxAge":1,"name":"Ms. Rachel  Duncan","title":"Chief People Officer","fiscalYear":2025,"exercisedValue":0,"unexercisedValue":0},{"maxAge":1,"name":"Ms. Aisling  Kane","age":56,"title":"Managing Director of Retail & Business Banking","yearBorn":1969,"fiscalYear":2025,"exercisedValue":0,"unexercisedValue":0},{"maxAge":1,"name":"Mr. Andy  Veares","title":"Managing Director of Corporate & Commercial","fiscalYear":2025,"exercisedValue":0,"unexercisedValue":0},{"maxAge":1,"name":"Ms. Kirsten  McLeod","title":"Chief Risk Officer","fiscalYear":2025,"exercisedValue":0,"unexercisedValue":0},{"maxAge":1,"name":"Ms. Kathy  Newman","title":"Chief Internal Auditor","fiscalYear":2025,"exercisedValue":0,"unexercisedValue":0}],"auditRisk":2,"boardRisk":5,"compensationRisk":9,"shareHolderRightsRisk":9,"overallRisk":7,"governanceEpochDate":1793491200,"compensationAsOfEpochDate":1767139200,"executiveTeam":[],"maxAge":86400,"priceHint":2,"previousClose":178.6,"open":185,"dayLow":182.2,"dayHigh":197,"regularMarketPreviousClose":178.6,"regularMarketOpen":185,"regularMarketDayLow":182.2,"regularMarketDayHigh":197,"dividendYield":0,"payoutRatio":0,"be