ic.pl/116","executiveTeam":[],"maxAge":86400,"priceHint":2,"previousClose":5.14,"open":5.22,"dayLow":5.22,"dayHigh":5.22,"regularMarketPreviousClose":5.14,"regularMarketOpen":5.22,"regularMarketDayLow":5.22,"regularMarketDayHigh":5.22,"dividendYield":0,"payoutRatio":0,"beta":0.486,"trailingPE":3.41176,"volume":902,"regularMarketVolume":902,"averageVolume":4650,"averageVolume10days":1253,"averageDailyVolume10Day":1253,"bid":5.14,"ask":5.18,"marketCap":33235738,"nonDilutedMarketCap":32726380,"fiftyTwoWeekLow":4.72,"fiftyTwoWeekHigh":6.38,"allTimeHigh":72.4,"allTimeLow":0.63,"fulldayPrice":5.22,"fulldayChange":0.0799999,"fulldayChangePercent":1.55642,"priceToSalesTrailing12Months":0.126811,"fiftyDayAverage":5.2296,"twoHundredDayAverage":5.24075,"trailingAnnualDividendRate":0,"trailingAnnualDividendYield":0,"currency":"PLN","tradeable":false,"enterpriseValue":132120976,"profitMargins":0.03718,"floatShares":2158731,"sharesOutstanding":6367000,"heldPercentInsiders":0.66095,"heldPercentInstitutions":0,"impliedSharesOutstanding":6367000,"bookValue":12.236,"priceToBook":0.42661,"lastFiscalYearEnd":1767139200,"nextFiscalYearEnd":1798675200,"mostRecentQuarter":1782777600,"netIncomeToCommon":9744000,"trailingEps":1.53,"lastSplitFactor":"1:10","lastSplitDate":1582588800,"enterpriseToRevenue":0.504,"enterpriseToEbitda":5.085,"52WeekChange":-0.0481482,"SandP52WeekChange":0.0796832,"quoteType":"EQUITY","currentPrice":5.22,"recommendationKey":"none","totalCash":273800,"totalCashPerShare":0.043,"ebitda":25982400,"totalDebt":99668400,"quickRatio":1.008,"currentRatio":1.479,"totalRevenue":262089504,"debtToEquity":127.935,"revenuePerShare":41.164,"returnOnAssets":0.04813,"returnOnEquity":0.13342,"grossProfits":79100096,"freeCashflow":8756525,"operatingCashflow":6641400,"revenueGrowth":0.087,"grossMargins":0.30181,"ebitdaMargins":0.09914,"operatingMargins":0.06992,"financialCurrency":"PLN","symbol":"HRP.WA","language":"en-US","region":"US","typeDisp":"Equity","quoteSourceName":"Delayed Q